  },
  "dependencies": {
    "@cloudflare/workers-response-store": "^0.1.0-beta.0",
    "@vinext/cloudflare": "^1.0.0-beta.8",
    "next": "15.2.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-server-dom-webpack": "^19.3.0",
    "vinext": "^1.0.0-beta.10"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.57.0",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitejs/plugin-rsc": "^0.5.35",
    "typescript": "^5",
    "vite": "^8.3.0",
    "wrangler": "^4.136.0"
  },
  "type": "module"
}
