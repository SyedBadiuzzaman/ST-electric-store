{
  "name": "hassan-electric-storefront",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "dev:vinext": "vinext dev --port 3001",
    "build:vinext": "vinext build",
